{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JWT": {
    "Issuer": "FlowDesk_ITSM-Proj-`Main`",
    "Audience": "FlowDesk_ITSM-Proj-`Main`",
    "SecretKey": "",
    "ExpiryInMinutes": 12,
    "RefreshTokenExpiryInDays": 7
  },
  "SystemAdmin": {
    "Email": "",
    "Username": "",
    "Password": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost"
    ]
  },
  "RefreshTokenCookie": {
    "Name": "refreshToken",
    "Path": "/api/v1/auth",
    "SameSite": "None"
  }
}